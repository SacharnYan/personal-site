---
import Base from '../../layouts/Base.astro';
import { href, type Lang } from '../../i18n/ui';
import sections from '../../data/index.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const isEn = lang === 'en';

const copy = isEn ? {
  pageTitle: 'Shucheng Yan — Solution Designer',
  description: 'Shucheng Yan is a solution designer who turns complex business problems into clear, usable products.',
  kicker: 'Shucheng Yan · Solution Designer',
  title1: 'I turn complex problems',
  title2: 'into clear, usable products.',
  lead: 'Based in Nanjing, I work across business analysis, product solutions, and experience design — from understanding a real situation to a solution a team can build, test, and use.',
  primary: 'View projects',
  secondary: 'About me',
  principleLabel: 'A lasting principle',
  principle: 'Learn always. Create with care. Express freely.',
  focusLabel: 'Current focus',
  focus: 'AI collaboration · Business-to-product translation · Interactive storytelling',
  practiceEyebrow: 'Practice',
  practiceTitle: 'How I make a problem clear',
  practiceLead: 'Good solutions do not begin with features. They begin with a shared understanding of the outcome, the people involved, and the evidence that will prove a change works.',
  featuredEyebrow: 'Selected work',
  featuredTitle: 'Ideas made tangible',
  featuredLead: 'Two small projects show the range I care about: useful structure on one side, memorable experience on the other.',
  collectionEyebrow: 'Ongoing archive',
  collectionTitle: 'Writing, images, and things worth keeping',
  collectionLead: 'This site is not only a portfolio. It is a working archive of what I make, notice, learn, and return to.',
  aboutEyebrow: 'About',
  aboutTitle: 'The work makes more sense when you know the path behind it.',
  aboutBody: 'Walk through an interactive timeline, or read the professional profile first. Both lead to the same question: how can complicated systems become experiences people can actually understand?',
  aboutCta: 'Explore my path',
} : {
  pageTitle: '严树成 — 解决方案设计师',
  description: '严树成的个人网站：把复杂的业务问题，做成清晰、可用、可验收的产品方案。',
  kicker: '严树成 · 解决方案设计师',
  title1: '把复杂的问题，',
  title2: '做成清晰、可用的产品。',
  lead: '我在南京工作，关注业务问题结构化、产品方案与体验设计。工作从理解真实场景开始，直到团队可以开发、测试，用户可以顺利使用。',
  primary: '查看项目',
  secondary: '了解我',
  principleLabel: '长期主张',
  principle: '终身学习，认真创造，自由表达。',
  focusLabel: '正在关注',
  focus: 'AI 协作 · 业务与产品连接 · 交互叙事',
  practiceEyebrow: 'Practice',
  practiceTitle: '我如何把一件事做清楚',
  practiceLead: '好的方案不从功能清单开始，而从共同理解开始：要改变什么结果、涉及哪些人、受到什么约束，又用什么证据判断它真的有效。',
  featuredEyebrow: 'Selected work',
  featuredTitle: '把想法做成可以体验的东西',
  featuredLead: '两个小项目，分别代表我在意的两端：一端是清晰有用的结构，一端是让人愿意停留的体验。',
  collectionEyebrow: 'Ongoing archive',
  collectionTitle: '写作、影像，以及值得留下的东西',
  collectionLead: '这里不只是作品集，也是一个持续生长的个人档案：记录我做过什么、看见什么、学到什么，以及反复回到什么。',
  aboutEyebrow: 'About',
  aboutTitle: '知道一段经历，才能更完整地理解一个人为什么这样工作。',
  aboutBody: '你可以先读职业介绍，也可以走进一条可交互的时间线。它们最终指向同一个问题：怎样让复杂的系统，变成真实的人能够理解和使用的体验？',
  aboutCta: '走进我的经历',
};

const practices = isEn ? [
  { no: '01', title: 'Understand the real problem', body: 'Separate goals, people, process, constraints, and evidence. Turn “we need a feature” back into the result that actually needs to change.' },
  { no: '02', title: 'Make the solution deliverable', body: 'Use information architecture, prototypes, rules, and acceptance criteria to translate business language into work development and testing can execute.' },
  { no: '03', title: 'Use technology to clarify', body: 'Combine AI, data, and interaction design so complex content becomes easier to understand without losing its human texture.' },
] : [
  { no: '01', title: '理解真实问题', body: '先分清目标、角色、流程、约束与证据，把“想要一个功能”还原成真正需要改变的结果。' },
  { no: '02', title: '把方案做到可交付', body: '用信息架构、原型、规则和验收标准，把业务语言翻译成开发与测试都能执行的方案。' },
  { no: '03', title: '用技术增强表达', body: '结合 AI、数据与交互技术，让复杂内容更容易理解，也让体验保留人的温度。' },
];

const featured = isEn ? [
  {
    href: '/projects/snow/',
    image: '/projects/snow/card.jpg',
    alt: 'A small boat heading toward Huxin Pavilion on a snowy night',
    meta: 'Interactive narrative · 2026',
    title: 'Snow at Huxin Pavilion',
    body: 'A three-dimensional West Lake built from Zhang Dai’s measure words — trace, dot, speck, grains — and turned into a scene you can row into.',
    cta: 'Read the story',
  },
  {
    href: '/projects/floral/',
    image: '/cards/projects-card.jpg',
    alt: 'Two floral course schedule posters',
    meta: 'Information design · 2026',
    title: 'Floral Course Schedule Posters',
    body: 'A dense curriculum reorganized into two coherent enrollment posters through AI-assisted exploration and careful human refinement.',
    cta: 'Read the case',
  },
] : [
  {
    href: '/projects/snow/',
    image: '/projects/snow/card.jpg',
    alt: '雪夜西湖，小舟驶向湖心亭',
    meta: '互动叙事 · 2026',
    title: '湖心亭看雪',
    body: '从张岱的几个量词出发，把“长堤一痕、湖心亭一点、余舟一芥、舟中人两三粒”做成一座可以划进去的三维雪夜西湖。',
    cta: '阅读项目故事',
  },
  {
    href: '/projects/floral/',
    image: '/cards/projects-card.jpg',
    alt: '两张花艺课程表招生海报',
    meta: '信息设计 · 2026',
    title: '花艺课程表海报',
    body: '把密集的课程信息重新组织成两张结构统一、重点清楚的招生海报，并用 AI 辅助探索版式，再由人完成判断与收敛。',
    cta: '阅读项目案例',
  },
];

const collectionItems = sections.slice(1).map((section: any) => {
  const en = section.en || {};
  return {
    eyebrow: isEn ? (en.eyebrow || section.eyebrow) : section.eyebrow,
    title: isEn ? (en.title || section.title) : section.title,
    sub: isEn ? (en.sub || section.sub) : section.sub,
    href: isEn ? (en.cta_href || href('en', section.cta.href)) : section.cta.href,
    cta: isEn ? (en.cta_label || section.cta.label) : section.cta.label,
    image: section.is_video ? section.poster : section.image,
    images: section.images,
    alt: isEn ? (en.image_alt || section.image_alt || '') : (section.image_alt || ''),
  };
});

collectionItems.splice(2, 0, {
  eyebrow: isEn ? 'Bookshelf' : '书架',
  title: isEn ? 'Things I return to' : '反复回到的东西',
  sub: isEn ? 'Books, essays, films, talks, and fragments that continue to shape how I think.' : '书、文章、影像、演讲和碎片——它们持续塑造我看问题的方式。',
  href: href(lang, '/shelf/'),
  cta: isEn ? 'Browse the shelf' : '打开书架',
  image: null,
  images: null,
  alt: '',
});
---

<Base title={copy.pageTitle} description={copy.description} lang={lang}>
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-kicker" data-fade>{copy.kicker}</p>
      <h1 class="hero-title" data-fade>
        <span>{copy.title1}</span>
        <span class="hero-title-muted">{copy.title2}</span>
      </h1>
      <p class="hero-lead" data-fade>{copy.lead}</p>
      <div class="hero-actions" data-fade>
        <a class="button button-primary" href={href(lang, '/projects/')}>{copy.primary}<span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href={href(lang, '/about/')}>{copy.secondary}<span aria-hidden="true">→</span></a>
      </div>
      <dl class="hero-meta" data-fade>
        <div>
          <dt>{copy.principleLabel}</dt>
          <dd>{copy.principle}</dd>
        </div>
        <div>
          <dt>{copy.focusLabel}</dt>
          <dd>{copy.focus}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="page-section practice-section" aria-labelledby="practice-title">
    <div class="section-inner">
      <header class="section-heading" data-fade>
        <p class="section-eyebrow">{copy.practiceEyebrow}</p>
        <div>
          <h2 id="practice-title">{copy.practiceTitle}</h2>
          <p>{copy.practiceLead}</p>
        </div>
      </header>
      <ol class="practice-grid">
        {practices.map((item) => (
          <li class="practice-item" data-fade>
            <span>{item.no}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-section featured-section" aria-labelledby="featured-title">
    <div class="section-inner">
      <header class="section-heading" data-fade>
        <p class="section-eyebrow">{copy.featuredEyebrow}</p>
        <div>
          <h2 id="featured-title">{copy.featuredTitle}</h2>
          <p>{copy.featuredLead}</p>
        </div>
      </header>
      <div class="featured-grid">
        {featured.map((item) => (
          <article class="project-card" data-fade>
            <a href={href(lang, item.href)} class="project-image-link" aria-label={`${item.title} — ${item.cta}`}>
              <img src={item.image} alt={item.alt} width="1440" height="960" loading="lazy" />
            </a>
            <p class="card-meta">{item.meta}</p>
            <h3><a href={href(lang, item.href)}>{item.title}</a></h3>
            <p class="card-body">{item.body}</p>
            <a class="text-link" href={href(lang, item.href)}>{item.cta}<span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
      <p class="all-projects" data-fade>
        <a class="text-link" href={href(lang, '/projects/')}>{isEn ? 'View all projects' : '查看全部项目'}<span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section class="page-section collection-section" aria-labelledby="collection-title">
    <div class="section-inner">
      <header class="section-heading" data-fade>
        <p class="section-eyebrow">{copy.collectionEyebrow}</p>
        <div>
          <h2 id="collection-title">{copy.collectionTitle}</h2>
          <p>{copy.collectionLead}</p>
        </div>
      </header>
      <div class="collection-list">
        {collectionItems.map((item: any, index: number) => (
          <article class="collection-item" data-fade>
            <div class="collection-index">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{item.eyebrow}</p>
            </div>
            <div class="collection-copy">
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.sub}</p>
              <a class="text-link" href={item.href}>{item.cta}<span aria-hidden="true">→</span></a>
            </div>
            <a class="collection-media" href={item.href} tabindex="-1" aria-hidden="true">
              {item.images ? (
                <span class="photo-grid">
                  {item.images.map((src: string) => <img src={src} alt="" loading="lazy" />)}
                </span>
              ) : item.image ? (
                <img src={item.image} alt={item.alt} loading="lazy" />
              ) : (
                <span class="shelf-mark" aria-hidden="true">
                  <i></i><i></i><i></i><i></i><i></i>
                </span>
              )}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-cta" aria-labelledby="about-cta-title">
    <div class="section-inner about-cta-inner" data-fade>
      <p class="section-eyebrow">{copy.aboutEyebrow}</p>
      <div>
        <h2 id="about-cta-title">{copy.aboutTitle}</h2>
        <p>{copy.aboutBody}</p>
        <a class="button button-primary" href={href(lang, '/about/')}>{copy.aboutCta}<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: min(920px, 100svh);
    padding: 176px 96px 88px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-rule);
  }

  .hero-inner,
  .section-inner {
    width: 100%;
    max-width: 1248px;
    margin: 0 auto;
  }

  .hero-kicker,
  .section-eyebrow,
  .card-meta,
  .collection-index {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
    letter-spacing: .03em;
    color: var(--color-fg-muted);
  }

  .hero-kicker { margin: 0 0 34px; }

  .hero-title {
    max-width: 1120px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(58px, 6.4vw, 92px);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.045em;
  }

  .hero-title span { display: block; }
  .hero-title-muted { color: var(--color-fg-muted); }

  .hero-lead {
    max-width: 760px;
    margin: 44px 0 0;
    font-size: 19px;
    line-height: 34px;
    color: #292929;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 11px 22px;
    border: 1px solid #000;
    border-radius: 999px;
    font-size: 15px;
    line-height: 24px;
    transition: background 200ms, color 200ms, border-color 200ms;
  }

  .button-primary { background: #000; color: #fff; }
  .button-primary:hover { background: #303030; border-color: #303030; }
  .button-secondary { background: #fff; color: #000; }
  .button-secondary:hover { background: #f5f5f5; }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin: 72px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--color-rule);
  }

  .hero-meta dt {
    margin-bottom: 8px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-fg-muted);
  }

  .hero-meta dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 28px;
  }

  .page-section { padding: 120px 96px; }
  .page-section + .page-section { border-top: 1px solid var(--color-rule); }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    margin-bottom: 72px;
  }

  .section-eyebrow { margin: 6px 0 0; }

  .section-heading h2,
  .about-cta h2 {
    max-width: 880px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(42px, 4.4vw, 64px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .section-heading > div > p,
  .about-cta-inner > div > p {
    max-width: 720px;
    margin: 28px 0 0;
    font-size: 17px;
    line-height: 30px;
    color: var(--color-fg-muted);
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .practice-item {
    min-height: 300px;
    padding: 30px 32px 36px 0;
  }

  .practice-item + .practice-item {
    padding-left: 32px;
    border-left: 1px solid var(--color-rule);
  }

  .practice-item > span {
    font-family: var(--font-display);
    font-size: 13px;
    color: var(--color-fg-muted);
  }

  .practice-item h3,
  .project-card h3,
  .collection-copy h3 {
    margin: 50px 0 16px;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 400;
    line-height: 38px;
    letter-spacing: -.025em;
  }

  .practice-item p,
  .card-body,
  .collection-copy > p {
    margin: 0;
    font-size: 15px;
    line-height: 27px;
    color: var(--color-fg-muted);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
  }

  .project-image-link {
    display: block;
    overflow: hidden;
    background: #f2f2f2;
  }

  .project-image-link img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(.22,1,.36,1), opacity 200ms;
  }

  .project-image-link:hover img { transform: scale(1.015); opacity: .92; }
  .card-meta { margin: 24px 0 0; }
  .project-card h3 { margin: 10px 0 12px; font-size: 34px; line-height: 42px; }
  .project-card h3 a:hover { color: var(--color-fg-muted); }
  .card-body { max-width: 55ch; }

  .text-link {
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(0,0,0,.34);
    font-size: 14px;
    line-height: 22px;
    transition: color 200ms, border-color 200ms;
  }

  .text-link span { transition: transform 220ms cubic-bezier(.22,1,.36,1); }
  .text-link:hover { color: var(--color-fg-muted); border-color: var(--color-fg-muted); }
  .text-link:hover span { transform: translateX(4px); }
  .all-projects { margin: 42px 0 0; }

  .collection-list { border-top: 1px solid var(--color-rule); }

  .collection-item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(280px, 420px);
    gap: 40px;
    align-items: center;
    min-height: 300px;
    padding: 48px 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .collection-index > span { display: block; margin-bottom: 28px; color: var(--color-fg-faint); }
  .collection-index p { margin: 0; color: #000; }
  .collection-copy h3 { margin: 0 0 14px; font-size: 34px; line-height: 42px; }
  .collection-copy h3 a:hover { color: var(--color-fg-muted); }

  .collection-media {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f2f2f2;
  }

  .collection-media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 200ms;
  }

  .collection-media:hover > img { opacity: .88; }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 3px;
    width: 100%;
    height: 100%;
  }

  .photo-grid img { width: 100%; height: 100%; object-fit: cover; }

  .shelf-mark {
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 9px;
    padding: 18% 12%;
  }

  .shelf-mark i { display: block; width: 12%; height: 76%; border: 1px solid #8a8a8a; background: #fff; }
  .shelf-mark i:nth-child(2) { height: 92%; }
  .shelf-mark i:nth-child(3) { height: 64%; }
  .shelf-mark i:nth-child(4) { height: 84%; transform: rotate(4deg); transform-origin: bottom; }
  .shelf-mark i:nth-child(5) { height: 70%; }

  .about-cta {
    padding: 120px 96px;
    border-top: 1px solid var(--color-rule);
    background: #f5f5f5;
  }

  .about-cta-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }

  .about-cta .button { margin-top: 34px; }

  @media (max-width: 980px) {
    .hero { padding-left: 48px; padding-right: 48px; }
    .page-section,
    .about-cta { padding-left: 48px; padding-right: 48px; }
    .collection-item { grid-template-columns: 110px minmax(0, 1fr) 300px; gap: 28px; }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100svh;
      padding: 132px 24px 48px;
      align-items: flex-start;
    }

    .hero-kicker { margin-bottom: 26px; }
    .hero-title { font-size: clamp(44px, 13vw, 58px); line-height: 1.04; letter-spacing: -.04em; }
    .hero-lead { margin-top: 30px; font-size: 16px; line-height: 29px; }
    .hero-actions { margin-top: 26px; }
    .button { min-height: 46px; padding: 10px 18px; font-size: 14px; }

    .hero-meta {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 46px;
      padding-top: 18px;
    }

    .hero-meta dd { font-size: 16px; line-height: 26px; }
    .page-section,
    .about-cta { padding: 80px 24px; }

    .section-heading,
    .about-cta-inner { grid-template-columns: 1fr; gap: 24px; margin-bottom: 48px; }
    .section-heading h2,
    .about-cta h2 { font-size: 40px; line-height: 1.12; }
    .section-heading > div > p,
    .about-cta-inner > div > p { margin-top: 20px; font-size: 16px; line-height: 28px; }

    .practice-grid { grid-template-columns: 1fr; }
    .practice-item,
    .practice-item + .practice-item { min-height: 0; padding: 28px 0 32px; border-left: 0; }
    .practice-item + .practice-item { border-top: 1px solid var(--color-rule); }
    .practice-item h3 { margin-top: 28px; font-size: 27px; line-height: 34px; }

    .featured-grid { grid-template-columns: 1fr; gap: 64px; }
