---
import Base from '../../layouts/Base.astro';
import { href, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const isEn = lang === 'en';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: isEn ? 'Shucheng Yan' : '严树成',
  alternateName: isEn ? '严树成' : 'Sacharn',
  url: `https://sacharn.site${isEn ? '/en' : ''}/about/`,
  jobTitle: isEn ? 'Solution Designer' : '解决方案设计师',
  worksFor: { '@type': 'Organization', name: 'Huawei' },
  homeLocation: { '@type': 'Place', name: isEn ? 'Nanjing, China' : '中国南京' },
  sameAs: ['https://github.com/SacharnYan'],
};

const path = [
  {
    date: isEn ? '1996–2014' : '1996–2014',
    title: isEn ? 'Growing up' : '成长',
    place: isEn ? 'Xinghua & Taizhou, Jiangsu' : '江苏兴化 · 泰州',
    detail: isEn
      ? 'Born in Xinghua. Through Caibao, Taizhou Experimental School and Kou\'an High School — play, coordinates, and dense stretches of time, as the world slowly found its order and direction.'
      : '出生于兴化。从蔡堡到泰州实验学校，再到口岸中学——游戏、坐标和密集的时间里，世界逐渐有了秩序和方向。',
  },
  {
    date: isEn ? '2014–2022' : '2014–2022',
    title: isEn ? 'Higher Education' : '高等教育',
    place: isEn ? 'Nanjing Univ. of Posts & Telecom · M.Eng.' : '南京邮电大学 · 硕士',
    detail: isEn
      ? 'From electronic information to communication engineering. Eight years in Nanjing — the city became home.'
      : '从电子信息到电子与通信工程。在南京的八年，这座城市成了家。',
  },
  {
    date: isEn ? '2022–2025' : '2022–2025',
    title: isEn ? 'Services Product' : '服务产品',
    place: isEn ? 'Huawei Device BG' : '华为终端 BG',
    detail: isEn
      ? 'Helping services move through systems to reach real people.'
      : '让服务穿过系统，抵达真实的人。',
  },
  {
    date: isEn ? '2025–Now' : '2025–现在',
    title: isEn ? 'Retail Product' : '零售产品',
    place: isEn ? 'Huawei Device BG' : '华为终端 BG',
    detail: isEn
      ? 'Turning complex systems into experiences people can feel.'
      : '把复杂的系统，变成可感知的体验。',
  },
];

const beliefs = [
  {
    text: isEn ? 'Learn always. Create with care. Express freely.' : '终身学习，认真创造，自由表达。',
    source: null,
  },
  {
    text: isEn ? 'Kindness is a choice.' : '善良是一种选择。',
    source: { href: href(lang, '/writing/worldview/'), label: isEn ? 'A Simple Worldview' : '《简约世界观》' },
  },
  {
    text: isEn ? 'Beware the fragments of themes.' : '警惕主题的碎片。',
    source: { href: href(lang, '/writing/fragments/'), label: isEn ? 'Beware the Fragmentation of Theme' : '《警惕主题的碎片》' },
  },
];
---

<Base
  title={isEn ? 'About — Sacharn' : '关于 — 思想名片'}
  description={isEn ? 'Shucheng Yan · Solution Designer at Huawei · Nanjing' : '严树成 · 华为解决方案设计师 · 南京'}
  lang={lang}
  jsonLd={jsonLd}
>
  <article class="about">
    <header class="about-hero" data-fade>
      <p class="eyebrow">{isEn ? 'About' : '关于'}</p>
      <h1 class="about-name">{isEn ? 'Shucheng Yan' : '严树成'}</h1>
      <p class="about-role">{isEn ? 'Solution Designer · Huawei · Nanjing' : '解决方案设计师 · 华为 · 南京'}</p>
      <div class="about-lede">
        {isEn ? (
          <p>I'm Shucheng Yan, an INFJ based in Nanjing. I enjoy turning ideas into interesting products — this site is where the process stays visible.</p>
        ) : (
          <p>我是严树成，INFJ，现居南京。喜欢把想法做成有趣的产品——这个网站是过程留下来的地方。</p>
        )}
      </div>
    </header>

    <section class="about-section" data-fade>
      <p class="eyebrow">{isEn ? 'Now' : '现在'}</p>
      <div class="about-prose">
        {isEn ? (
          <>
            <p>I work on retail products at Huawei Device BG: turning complex systems into experiences people can actually feel in a store.</p>
            <p>Outside of work I write, take photographs, and occasionally film slow vlogs. Everything here is made by hand and kept for the long term.</p>
          </>
        ) : (
          <>
            <p>在华为终端 BG 做零售产品：把复杂的系统，变成人们在店里能真实感知的体验。</p>
            <p>工作之外写作、拍照，偶尔拍很慢的 vlog。这个网站上的东西都是手工做的，打算长期养下去。</p>
          </>
        )}
      </div>
    </section>

    <section class="about-section" data-fade>
      <p class="eyebrow">{isEn ? 'Path' : '经历'}</p>
      <ol class="path-list">
        {path.map((item) => (
          <li class="path-item">
            <p class="path-date">{item.date}</p>
            <div class="path-body">
              <h2 class="path-title">{item.title}</h2>
              <p class="path-place">{item.place}</p>
              <p class="path-detail">{item.detail}</p>
            </div>
          </li>
        ))}
        <li class="path-item path-item--open">
          <p class="path-date">{isEn ? 'Beyond' : '此刻之后'}</p>
          <div class="path-body">
            <h2 class="path-title">{isEn ? 'Still becoming.' : '仍在成为。'}</h2>
          </div>
        </li>
      </ol>
      <div class="path-journey">
        <a href={href(lang, '/journey/')} class="path-link">
          {isEn ? 'Walk the 3D corridor' : '走进这条走廊'} <span aria-hidden="true">→</span>
        </a>
        <p class="path-journey-note">{isEn ? 'The same path as an interactive scene · WebGL' : '同一段经历的 3D 互动场景 · 需要 WebGL'}</p>
      </div>
    </section>

    <section class="about-section" data-fade>
      <p class="eyebrow">{isEn ? 'Beliefs' : '相信的事'}</p>
      <ul class="belief-list">
        {beliefs.map((b) => (
          <li class="belief-item">
            <p class="belief-text">{b.text}</p>
            {b.source && (
              <a href={b.source.href} class="belief-source">{b.source.label}</a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section about-contact" data-fade>
      <p class="eyebrow">{isEn ? 'Contact' : '联系'}</p>
      <p class="about-prose">{isEn ? 'Letters are always welcome.' : '欢迎写信给我，什么都可以聊。'}</p>
      <ul class="contact-list">
        <li><a href="mailto:sacharn@163.com" class="contact-link" data-mail="sacharn@163.com">{isEn ? 'Email' : '邮件'}</a></li>
        <li><span class="contact-link contact-link--plain">{isEn ? 'WeChat' : '微信'} sacharn</span></li>
        <li><a href="https://github.com/SacharnYan" class="contact-link" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={href(lang, '/rss.xml')} class="contact-link">RSS</a></li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .about {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 20px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b8b8b8;
    margin: 0 0 24px 0;
  }

  /* ===== Hero ===== */
  .about-hero {
    padding: 160px 0 96px;
  }

  .about-name {
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
    margin: 0 0 16px 0;
  }

  .about-role {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.4;
    color: #707070;
    margin: 0 0 40px 0;
  }

  .about-lede {
    max-width: 560px;
    font-size: 17px;
    line-height: 30px;
    color: #292929;
  }

  .about-lede p { margin: 0; }

  /* ===== Sections ===== */
  .about-section {
    padding: 72px 0;
    border-top: 1px solid #d0d0d0;
  }

  .about-prose {
    max-width: 560px;
    font-size: 17px;
    line-height: 30px;
    color: #292929;
  }

  .about-prose p { margin: 0; }
  .about-prose p + p { margin-top: 12px; color: #707070; }

  /* ===== Path ===== */
  .path-list {
    display: flex;
    flex-direction: column;
  }

  .path-item {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 32px;
    padding: 28px 0;
  }

  .path-item + .path-item {
    border-top: 1px solid rgba(0,0,0,.07);
  }

  .path-date {
    font-size: 14px;
    line-height: 24px;
    color: #707070;
    margin: 3px 0 0 0;
    font-variant-numeric: tabular-nums;
  }

  .path-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.35;
    color: #000;
    margin: 0 0 6px 0;
  }

  .path-place {
    font-size: 15px;
    line-height: 24px;
    color: #707070;
    margin: 0 0 10px 0;
  }

  .path-detail {
    font-size: 16px;
    line-height: 28px;
    color: #292929;
    margin: 0;
  }

  .path-item--open .path-title { color: #707070; }

  .path-journey {
    margin-top: 40px;
    padding: 32px;
    background: #f5f5f5;
    border-radius: 4px;
  }

  .path-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(0,0,0,.35);
    font-size: 15px;
    line-height: 24px;
    color: #000;
    transition: border-color 200ms, color 200ms;
  }

  .path-link:hover { color: #707070; border-color: #707070; }
  .path-link span { transition: transform 220ms cubic-bezier(.22,1,.36,1); }
  .path-link:hover span { transform: translateX(4px); }

  .path-journey-note {
    margin: 14px 0 0 0;
    font-size: 13px;
    line-height: 20px;
    color: #8a8a8a;
  }

  /* ===== Beliefs ===== */
  .belief-list {
    display: flex;
    flex-direction: column;
  }

  .belief-item {
    padding: 24px 0;
  }

  .belief-item + .belief-item {
    border-top: 1px solid rgba(0,0,0,.07);
  }

  .belief-text {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.4;
    color: #000;
    margin: 0;
  }

  .belief-source {
    display: inline-block;
    margin-top: 8px;
    font-size: 14px;
    line-height: 22px;
    color: #707070;
    border-bottom: 1px solid rgba(0,0,0,.18);
    padding-bottom: 2px;
    transition: color 200ms, border-color 200ms;
  }

  .belief-source:hover { color: #000; border-color: #000; }

  /* ===== Contact ===== */
  .about-contact .about-prose { margin-bottom: 32px; }

  .contact-list {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
  }

  .contact-link {
    font-size: 16px;
    line-height: 24px;
    color: #000;
    border-bottom: 1px solid rgba(0,0,0,.35);
    padding-bottom: 2px;
    transition: color 200ms, border-color 200ms;
  }

  .contact-link:hover { color: #707070; border-color: #707070; }

  .contact-link--plain {
    border-bottom-color: transparent;
    cursor: default;
  }

  .contact-link--plain:hover { color: #000; }

  @media (max-width: 768px) {
    .about-hero { padding: 120px 0 64px; }

    .about-name { font-size: 36px; }

    .about-role { font-size: 20px; margin-bottom: 32px; }

    .about-section { padding: 56px 0; }

    .path-item {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 24px 0;
    }

    .path-journey { padding: 24px; }

    .belief-text { font-size: 20px; }
  }
</style>
