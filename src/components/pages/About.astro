---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const isEn = lang === 'en';

const timeline = [
  { theme: 'origin', date: '1996', date_en: '1996', stage: '出生', stage_en: 'Born', place: '江苏省兴化市', place_en: 'Xinghua, Jiangsu', detail: '故事从这里开始。', detail_en: 'The story begins here.' },
  { theme: 'play', date: '2000–2002', date_en: '2000–2002', stage: '幼儿园', stage_en: 'Kindergarten', place: '蔡堡中心幼儿园', place_en: 'Caibao Central Kindergarten', detail: '游戏、颜色，以及最初的好奇心。', detail_en: 'Play, color, and the first stirrings of curiosity.' },
  { theme: 'notebook', date: '2002–2008', date_en: '2002–2008', stage: '小学', stage_en: 'Primary School', place: '蔡堡中心小学、陈堡中心小学', place_en: 'Caibao & Chenbao Primary Schools', detail: '一页页写下，世界开始有了秩序。', detail_en: 'Page by page, the world begins to find an order.' },
  { theme: 'geometry', date: '2008–2011', date_en: '2008–2011', stage: '初中', stage_en: 'Middle School', place: '泰州实验学校', place_en: 'Taizhou Experimental School', detail: '坐标、尺度，和逐渐扩大的世界。', detail_en: 'Coordinates, scale, and a world growing larger.' },
  { theme: 'focus', date: '2011–2014', date_en: '2011–2014', stage: '高中', stage_en: 'High School', place: '江苏省口岸中学', place_en: "Kou'an High School, Jiangsu", detail: '在密集的时间里，寻找自己的方向。', detail_en: 'Finding a direction inside an intense stretch of time.' },
  { theme: 'signal', date: '2014–2022', date_en: '2014–2022', stage: '高等教育', stage_en: 'Higher Education', place: '电子信息 → 电子与通信工程 · 硕士毕业于南京邮电大学', place_en: 'Electronic Information → Electronic & Communication Engineering · M.Eng., Nanjing Univ. of Posts & Telecom', detail: '从电子信息走向通信工程。', detail_en: 'From electronic information to communication engineering.' },
  { theme: 'network', date: '2022–2025', date_en: '2022–2025', stage: '工作', stage_en: 'Work', place: '华为终端 BG · 服务产品', place_en: 'Huawei Device BG · Services Product', detail: '让服务穿过系统，抵达真实的人。', detail_en: 'Helping services move through systems to reach real people.' },
  { theme: 'retail', date: '2025–现在', date_en: '2025–Now', stage: '工作', stage_en: 'Work', place: '华为终端 BG · 零售产品', place_en: 'Huawei Device BG · Retail Product', detail: '把复杂的系统，变成可感知的体验。', detail_en: 'Turning complex systems into experiences people can feel.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: isEn ? 'Shucheng Yan' : '严树成',
  alternateName: isEn ? '严树成' : 'Sacharn',
  url: `https://sacharn.site${isEn ? '/en' : ''}/about/`,
  jobTitle: isEn ? 'Retail Product Manager' : '零售产品经理',
  worksFor: { '@type': 'Organization', name: 'Huawei' },
  homeLocation: { '@type': 'Place', name: isEn ? 'Nanjing, China' : '中国南京' },
  sameAs: ['https://github.com/SacharnYan'],
};
---

<Base
  title={isEn ? 'About — Sacharn' : '关于 — 思想名片'}
  description={isEn ? 'Shucheng Yan · Retail Product Management at Huawei · Nanjing' : '严树成 · 华为零售产品管理 · 南京'}
  lang={lang}
  jsonLd={jsonLd}
>
  <article class="article">
    <header class="article-hero" data-fade>
      <p class="article-eyebrow">About</p>
      <h1 class="article-title">{t(lang, 'about.title1')}</h1>
      <p class="article-sub">{t(lang, 'about.title2')}</p>
    </header>

    <div class="article-intro">
      <p>{t(lang, 'about.intro1')}</p>
      <p>{t(lang, 'about.intro2')}</p>
      <h2 class="section-title">{t(lang, 'about.secPath')}</h2>
      <p class="journey-lead">
        {isEn ? 'Walk forward. The corridor will remember where you have been.' : '向前走。长廊会记得来时的每一段路。'}
      </p>
    </div>

    <section
      class="sketch-journey"
      data-sketch-journey
      style={`--steps:${timeline.length + 1}`}
      aria-label={isEn ? 'An interactive life journey' : '交互式人生经历'}
    >
      <div class="journey-sticky">
        <canvas class="journey-canvas" data-journey-canvas aria-hidden="true"></canvas>
        <div class="paper-grain" aria-hidden="true"></div>
        <div class="journey-vignette" aria-hidden="true"></div>

        <div class="journey-heading" aria-hidden="true">
          <p>{isEn ? 'A life in chapters' : '一生 · 数章'}</p>
          <span data-progress-label>01 / {String(timeline.length + 1).padStart(2, '0')}</span>
        </div>

        <div class="chapter-layer" aria-live="polite">
          {timeline.map((item, index) => (
            <section class="chapter" data-chapter data-side={index % 2 ? 'right' : 'left'}>
              <p class="chapter-number">{String(index + 1).padStart(2, '0')}</p>
              <p class="chapter-date">{isEn ? item.date_en : item.date}</p>
              <h3>{isEn ? item.stage_en : item.stage}</h3>
              <p class="chapter-place">{isEn ? item.place_en : item.place}</p>
              <p class="chapter-detail">{isEn ? item.detail_en : item.detail}</p>
            </section>
          ))}
          <section class="chapter chapter-horizon" data-chapter data-side="center">
            <p class="chapter-number">{String(timeline.length + 1).padStart(2, '0')}</p>
            <p class="chapter-date">{isEn ? 'Beyond the present' : '此刻之后'}</p>
            <h3>{isEn ? 'Still becoming.' : '仍在成为。'}</h3>
            <p class="chapter-detail">{isEn ? 'The road does not end here.' : '路没有在这里结束。'}</p>
          </section>
        </div>

        <p class="journey-hint" data-journey-hint aria-hidden="true">
          {isEn ? 'Scroll to walk' : '滚动，向前走'}
          <span></span>
        </p>
        <div class="journey-progress" aria-hidden="true"><i data-progress-bar></i></div>
        <p class="webgl-note" data-webgl-note hidden>
          {isEn ? 'Your browser cannot display this 3D scene. The complete timeline follows.' : '当前浏览器无法显示 3D 场景，完整经历见下方。'}
        </p>
      </div>

      <ol class="journey-accessible">
        {timeline.map((item) => (
          <li>
            <p>{isEn ? item.date_en : item.date}</p>
            <h3>{isEn ? item.stage_en : item.stage}</h3>
            <p>{isEn ? item.place_en : item.place}</p>
            <p>{isEn ? item.detail_en : item.detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="article-contact">
      <h2 class="section-title">{t(lang, 'about.secContact')}</h2>
      {isEn ? (
        <p>
          If an email says it best, write to <a href="mailto:sacharn@163.com" class="inline-link">sacharn@163.com</a>; WeChat: sacharn; code on <a href="https://github.com/SacharnYan" class="inline-link" target="_blank" rel="noopener">GitHub</a>.
        </p>
      ) : (
        <p>
          如果邮件能讲清楚，请写信到 <a href="mailto:sacharn@163.com" class="inline-link">sacharn@163.com</a>；微信加 sacharn；代码在 <a href="https://github.com/SacharnYan" class="inline-link" target="_blank" rel="noopener">GitHub</a>。
        </p>
      )}
    </div>
  </article>
</Base>

<script is:inline src="/snow/three.min.js"></script>
<script is:inline>
  (function () {
    var root = document.querySelector('[data-sketch-journey]');
    var canvas = root && root.querySelector('[data-journey-canvas]');
    if (!root || !canvas) return;

    var chapters = root.querySelectorAll('[data-chapter]');
    var progressLabel = root.querySelector('[data-progress-label]');
    var progressBar = root.querySelector('[data-progress-bar]');
    var hint = root.querySelector('[data-journey-hint]');
    var note = root.querySelector('[data-webgl-note]');
    var reduced = false;
    try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

    if (reduced || !window.THREE) {
      root.classList.add('is-static');
      if (!window.THREE && note) note.hidden = false;
      return;
    }

    var THREE = window.THREE;
    var scene, camera, renderer;
    try {
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0xeeeade);
      scene.fog = new THREE.Fog(0xeeeade, 10, 58);
      camera = new THREE.PerspectiveCamera(50, 1, 0.1, 260);
      renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
    } catch (e) {
      root.classList.add('is-static');
      if (note) note.hidden = false;
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.7));
    renderer.outputEncoding = THREE.sRGBEncoding;

    var ink = 0x171814;
    var paper = 0xeeeade;
    var wash = [0xb76f55, 0xc89a55, 0x6f8f88, 0x607a9b, 0x8c735b, 0xb26f55, 0x6d8470, 0xbf765d];
    var stepDepth = 17;
    var firstZ = -13;
    var count = chapters.length;
    var lastStageZ = firstZ - (count - 2) * stepDepth;
    var endZ = lastStageZ - 19;
    var world = new THREE.Group();
    scene.add(world);

    function lineMaterial(color, opacity) {
      return new THREE.LineBasicMaterial({ color: color || ink, transparent: opacity < 1, opacity: opacity == null ? 1 : opacity });
    }

    function addEdges(group, geometry, material, position, rotation, scale) {
      var edges = new THREE.LineSegments(new THREE.EdgesGeometry(geometry), material);
      if (position) edges.position.set(position[0], position[1], position[2]);
      if (rotation) edges.rotation.set(rotation[0], rotation[1], rotation[2]);
      if (scale) edges.scale.set(scale[0], scale[1], scale[2]);
      group.add(edges);
      return edges;
    }

    function addLine(group, points, material) {
      var geometry = new THREE.BufferGeometry().setFromPoints(points.map(function (p) {
        return new THREE.Vector3(p[0], p[1], p[2]);
      }));
      var line = new THREE.Line(geometry, material);
      group.add(line);
      return line;
    }

    function addPaperPlane(group, w, h, color, opacity) {
      var material = new THREE.MeshBasicMaterial({
        color: color,
        transparent: opacity < 1,
        opacity: opacity,
        side: THREE.DoubleSide,
        depthWrite: opacity >= 1
      });
      var mesh = new THREE.Mesh(new THREE.PlaneGeometry(w, h), material);
      group.add(mesh);
      return mesh;
    }

    function makeNumberTexture(number) {
      var c = document.createElement('canvas');
      c.width = 256; c.height = 256;
      var ctx = c.getContext('2d');
      ctx.clearRect(0, 0, 256, 256);
      ctx.fillStyle = '#171814';
      ctx.font = '400 118px Georgia, serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(number, 128, 133);
      ctx.strokeStyle = 'rgba(23,24,20,.2)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(52, 201); ctx.lineTo(204, 197);
      ctx.stroke();
      var texture = new THREE.CanvasTexture(c);
      texture.minFilter = THREE.LinearFilter;
      return texture;
    }

    function sketchDoor(index, z) {
      var side = index % 2 ? 1 : -1;
      var group = new THREE.Group();
      group.position.set(side * 5.83, 0, z);
      group.rotation.y = side > 0 ? -Math.PI / 2 : Math.PI / 2;
      world.add(group);

      var wallPaper = addPaperPlane(group, 8.4, 8.6, paper, 1);
      wallPaper.position.set(0, 4.3, 0.035);

      var accent = addPaperPlane(group, 3.25, 5.7, wash[index], 0.0);
      accent.position.set(0, 3.0, 0.085);
      accent.userData.targetOpacity = 0;

      var doorPaper = addPaperPlane(group, 3.25, 5.7, 0xf5f1e7, 1);
      doorPaper.position.set(0, 3.0, 0.1);

      var frameMat = lineMaterial(ink, 0.9);
      addEdges(group, new THREE.BoxGeometry(3.55, 6.0, 0.12), frameMat, [0, 3.0, 0.1]);
      addEdges(group, new THREE.BoxGeometry(3.25, 5.7, 0.08), lineMaterial(ink, 0.45), [0, 3.0, 0.12]);

      var number = new THREE.Mesh(
        new THREE.PlaneGeometry(1.55, 1.55),
        new THREE.MeshBasicMaterial({ map: makeNumberTexture(String(index + 1).padStart(2, '0')), transparent: true, side: THREE.DoubleSide })
      );
      number.position.set(0, 3.15, 0.18);
      group.add(number);

      addLine(group, [[-1.62, 5.72, .18], [1.62, 5.68, .18]], lineMaterial(ink, .62));
      addLine(group, [[-1.62, .18, .18], [1.62, .22, .18]], lineMaterial(ink, .45));

      var motif = new THREE.Group();
      motif.position.set(0, 3.0, 0.24);
      group.add(motif);
      var faint = lineMaterial(ink, .38);

      if (index === 0) {
        addEdges(motif, new THREE.RingGeometry(1.03, 1.06, 48), faint);
        addEdges(motif, new THREE.RingGeometry(1.27, 1.29, 48), lineMaterial(ink, .18));
      } else if (index === 1) {
        addLine(motif, [[-1.1,-1.5,0],[.9,1.25,0],[-.7,.55,0],[1.15,-.65,0],[-1.1,-1.5,0]], faint);
        addEdges(motif, new THREE.CircleGeometry(.26, 16), faint, [-.65,.75,0]);
        addEdges(motif, new THREE.CircleGeometry(.18, 16), faint, [.72,-.9,0]);
      } else if (index === 2) {
        for (var r = -2; r <= 2; r++) addLine(motif, [[-1.18,r*.46,0],[1.16,r*.46+.03,0]], faint);
        addLine(motif, [[-.76,-1.25,0],[-.76,1.25,0]], lineMaterial(0xb76f55,.58));
      } else if (index === 3) {
        addLine(motif, [[-1.1,-1.15,0],[1.05,-1.15,0],[.32,1.18,0],[-1.1,-1.15,0]], faint);
        addEdges(motif, new THREE.CircleGeometry(.67, 28), faint, [.3,.05,0]);
        addLine(motif, [[-1.2,.15,0],[1.2,.15,0],[0,1.35,0],[0,-1.35,0]], lineMaterial(ink,.2));
      } else if (index === 4) {
        for (var b = -2; b <= 2; b++) addLine(motif, [[b*.42,-1.3,0],[b*.42,1.3,0]], lineMaterial(ink,b === 0 ? .62 : .22));
        addLine(motif, [[-1.08,.82,0],[1.08,.82,0]], faint);
      } else if (index === 5) {
        var pts = [];
        for (var s = 0; s < 42; s++) pts.push([-1.2+s*.058, Math.sin(s*.55)*(.16+s*.009), 0]);
        addLine(motif, pts, lineMaterial(0x607a9b,.72));
        addLine(motif, [[-1.2,-.9,0],[1.2,-.9,0]], faint);
      } else if (index === 6) {
        var nodes = [[-1,-.85],[-.72,.7],[0,-.1],[.62,.94],[1,-.68]];
        addLine(motif, nodes.map(function(n){return [n[0],n[1],0];}), faint);
        nodes.forEach(function(n){ addEdges(motif,new THREE.CircleGeometry(.12,14),lineMaterial(0x6d8470,.75),[n[0],n[1],0]); });
      } else {
        addLine(motif, [[-1.15,-1.22,0],[-1.15,1.22,0],[1.15,1.22,0],[1.15,-1.22,0]], faint);
        for (var y = -1; y <= 1; y++) addLine(motif, [[-1.15,y*.72,0],[1.15,y*.72,0]], lineMaterial(ink,.32));
        for (var x = -1; x <= 1; x++) addLine(motif, [[x*.72,-1.2,0],[x*.72,1.2,0]], lineMaterial(ink,.2));
      }

      group.userData = { accent: accent, side: side, z: z };
      return group;
    }

    var stages = [];
    for (var i = 0; i < count - 1; i++) stages.push(sketchDoor(i, firstZ - i * stepDepth));

    var wallMat = new THREE.MeshBasicMaterial({ color: paper, side: THREE.DoubleSide });
    var floor = new THREE.Mesh(new THREE.PlaneGeometry(12, Math.abs(endZ) + 36), wallMat);
    floor.rotation.x = -Math.PI / 2;
    floor.position.set(0, 0, endZ / 2 + 5);
    world.add(floor);
    var ceiling = floor.clone();
    ceiling.position.y = 8.6;
    ceiling.rotation.x = Math.PI / 2;
    world.add(ceiling);
    var leftWall = new THREE.Mesh(new THREE.PlaneGeometry(Math.abs(endZ) + 36, 8.6), wallMat);
    leftWall.rotation.y = Math.PI / 2;
    leftWall.position.set(-5.85, 4.3, endZ / 2 + 5);
    world.add(leftWall);
    var rightWall = leftWall.clone();
    rightWall.rotation.y = -Math.PI / 2;
    rightWall.position.x = 5.85;
    world.add(rightWall);

    var corridorInk = lineMaterial(ink, .2);
    addLine(world, [[-5.85,0,8],[-5.85,0,endZ]], corridorInk);
    addLine(world, [[5.85,0,8],[5.85,0,endZ]], corridorInk);
    addLine(world, [[-5.85,8.6,8],[-5.85,8.6,endZ]], corridorInk);
    addLine(world, [[5.85,8.6,8],[5.85,8.6,endZ]], corridorInk);
    for (var gz = 8; gz > endZ; gz -= 8.5) {
      addLine(world, [[-5.85,.01,gz],[5.85,.01,gz]], lineMaterial(ink,.11));
      addLine(world, [[-5.85,8.59,gz],[5.85,8.59,gz]], lineMaterial(ink,.09));
    }

    var horizon = new THREE.Group();
    horizon.position.set(0, 0, endZ - 3);
    horizon.visible = false;
    world.add(horizon);
    var sky = addPaperPlane(horizon, 24, 14, 0xd8e5e2, 1);
    sky.position.set(0, 6, -.8);
    var opening = addEdges(horizon, new THREE.BoxGeometry(7.4, 7.2, .1), lineMaterial(ink,.72), [0,3.6,0]);
    var path = addPaperPlane(horizon, 3.2, 18, 0xd0bd98, .44);
    path.rotation.x = -Math.PI / 2;
    path.position.set(0,.03,-7);
    addLine(horizon, [[-3.7,0,0],[-8,0,-11]], lineMaterial(ink,.4));
    addLine(horizon, [[3.7,0,0],[8,0,-11]], lineMaterial(ink,.4));
    addLine(horizon, [[-1.6,.04,0],[-4.5,.04,-18]], lineMaterial(ink,.24));
    addLine(horizon, [[1.6,.04,0],[4.5,.04,-18]], lineMaterial(ink,.24));
    addLine(horizon, [[-.95,4.95,.12],[.95,4.48,.12],[-.22,4.16,.12],[-.12,3.56,.12],[-.57,4.08,.12],[-.95,4.95,.12]], lineMaterial(ink,.72));
    addLine(horizon, [[-.57,4.08,.12],[.28,4.43,.12]], lineMaterial(ink,.42));
    addEdges(horizon, new THREE.CircleGeometry(.46, 24), lineMaterial(ink,.18), [-2.9,5.65,.05]);
    addEdges(horizon, new THREE.CircleGeometry(.34, 24), lineMaterial(ink,.18), [-2.35,5.55,.05]);
    addEdges(horizon, new THREE.CircleGeometry(.28, 24), lineMaterial(ink,.18), [2.65,5.15,.05]);
    addEdges(horizon, new THREE.CircleGeometry(.19, 24), lineMaterial(ink,.18), [3.04,5.09,.05]);

    var pointerX = 0, pointerY = 0, targetProgress = 0, smoothProgress = 0, smoothGlance = 0;
    var clock = new THREE.Clock();

    function clamp(n, min, max) { return Math.max(min, Math.min(max, n)); }
    function updateScroll() {
      var rect = root.getBoundingClientRect();
      var range = Math.max(1, root.offsetHeight - window.innerHeight);
      targetProgress = clamp(-rect.top / range, 0, 1);
    }

    function renderDom(progress) {
      var raw = progress * (count - 1);
      var active = Math.min(count - 1, Math.max(0, Math.round(raw)));
      for (var j = 0; j < chapters.length; j++) {
        var opacity = j === active ? 1 : 0;
        chapters[j].style.setProperty('--chapter-opacity', opacity.toFixed(3));
      }
      if (progressLabel) progressLabel.textContent = String(active + 1).padStart(2, '0') + ' / ' + String(count).padStart(2, '0');
      if (progressBar) progressBar.style.transform = 'scaleX(' + progress.toFixed(4) + ')';
      if (hint) hint.style.opacity = progress > .025 ? '0' : '1';
    }

    function resize() {
      var w = canvas.clientWidth || window.innerWidth;
      var h = canvas.clientHeight || window.innerHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    }

    function animate() {
      requestAnimationFrame(animate);
      var dt = Math.min(clock.getDelta(), .05);
      smoothProgress += (targetProgress - smoothProgress) * (1 - Math.exp(-5.2 * dt));
      var chapterFloat = smoothProgress * (count - 1);
      var endReveal = clamp((smoothProgress - .91) / .075, 0, 1);
      var travelEnd = endZ + 9;
      var z = 3 + (travelEnd - 3) * smoothProgress;
      var glance = 0;
      var glanceWeight = 0;
      for (var g = 0; g < stages.length; g++) {
        var influence = clamp(1 - Math.abs(chapterFloat - g), 0, 1);
        influence = influence * influence * (3 - 2 * influence);
        glance += stages[g].userData.side * influence;
        glanceWeight += influence;
      }
      if (glanceWeight > 0) glance /= glanceWeight;
      smoothGlance += (glance - smoothGlance) * (1 - Math.exp(-5 * dt));
      renderDom(smoothProgress);

      camera.position.x += ((smoothGlance * 1.0 + pointerX * .34) - camera.position.x) * (1 - Math.exp(-4 * dt));
      camera.position.y += ((3.25 - pointerY * .22 + Math.sin(performance.now() * .00035) * .035) - camera.position.y) * (1 - Math.exp(-4 * dt));
      camera.position.z = z;
      camera.lookAt(camera.position.x + smoothGlance * 3.5 + pointerX * .45, 3.15 - pointerY * .25, z - 10);

      for (var k = 0; k < stages.length; k++) {
        var approach = clamp(1 - Math.abs(chapterFloat - k) / .8, 0, 1);
        stages[k].userData.accent.material.opacity += ((approach * .18) - stages[k].userData.accent.material.opacity) * (1 - Math.exp(-6 * dt));
      }

      horizon.visible = endReveal > .01;
      sky.material.opacity = endReveal;
      path.material.opacity = endReveal * .44;
      opening.material.opacity = endReveal * .72;
      scene.fog.far = 58 + endReveal * 82;
      renderer.render(scene, camera);
    }

    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', function () { resize(); updateScroll(); });
    window.addEventListener('pointermove', function (e) {
      pointerX = (e.clientX / window.innerWidth - .5) * 2;
      pointerY = (e.clientY / window.innerHeight - .5) * 2;
    }, { passive: true });

    camera.position.set(0, 3.25, 3);
    resize();
    updateScroll();
    smoothProgress = targetProgress;
    renderDom(smoothProgress);
    animate();
  })();
</script>

<style>
  .article {
    max-width: none;
    margin: 0;
    padding: 0 0 160px;
    overflow: clip;
  }

